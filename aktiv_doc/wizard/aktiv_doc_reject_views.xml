<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="aktiv_doc_reject_view_form" model="ir.ui.view">
        <field name="name">aktiv.doc.reject.form</field>
        <field name="model">aktiv.doc.reject</field>
        <field name="arch" type="xml">
            <form string="Відхилити документ">
                <group>
                    <field name="document_id"/>
                    <field name="reason" placeholder="Що не так і що виправити"/>
                </group>
                <footer>
                    <button name="action_reject" type="object" string="Відхилити" class="btn-danger"
                            help="Відмовитися підписувати документ; контрагент побачить причину в Active Doc."/>
                    <button string="Скасувати" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
