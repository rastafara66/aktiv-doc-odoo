<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Кожна організація бачить лише свої документи Active Doc. Без групи — обмеження
         (у Odoo 20 `ir.access` без `group_id` — restriction, як глобальне `ir.rule`). -->
    <record id="aktiv_doc_document_company_rule" model="ir.access">
        <field name="name">Active Doc: документи своєї організації</field>
        <field name="model_id" ref="model_aktiv_doc_document"/>
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
    <!-- Звіти до ДПС — так само: лише своєї організації. -->
    <record id="aktiv_doc_report_company_rule" model="ir.access">
        <field name="name">Active Doc: звіти до ДПС своєї організації</field>
        <field name="model_id" ref="model_aktiv_doc_report"/>
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="aktiv_doc_report_receipt_company_rule" model="ir.access">
        <field name="name">Active Doc: квитанції ДПС своєї організації</field>
        <field name="model_id" ref="model_aktiv_doc_report_receipt"/>
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
