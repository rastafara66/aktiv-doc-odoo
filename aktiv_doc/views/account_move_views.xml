<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_aktiv_doc" model="ir.ui.view">
        <field name="name">account.move.form.aktiv.doc</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="aktiv_doc_enabled" invisible="True"/>
                <button name="action_aktiv_doc_send" type="object" string="Надіслати на підпис"
                        invisible="not aktiv_doc_enabled or state != 'posted' or move_type == 'entry'"
                        groups="account.group_account_invoice"
                        help="Підписати друковану форму КЕП тут же, в Odoo, і надіслати контрагенту через Active Doc."/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_aktiv_doc_open" type="object" class="oe_stat_button"
                        icon="fa-pencil-square-o" invisible="not aktiv_doc_count"
                        help="Документи Active Doc, надіслані з цього запису, і їхній стан.">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="aktiv_doc_count"/></span>
                        <span class="o_stat_text"><field name="aktiv_doc_state_label"/></span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
